# Production settings for docker-compose.prod.yml. Copy to .env.production (gitignored), fill
# in every value, then run: npm run prod -- up -d --build
# Generate each secret with: openssl rand -hex 32

# Public hostnames, served by Cloudflare over HTTPS (see SELF-HOSTING.md).
APP_HOSTNAME=sobi.wtchthfck.com
API_HOSTNAME=sobi-api.wtchthfck.com
# Only for the bundled tunnel (--profile tunnel): the token from the connector install command in
# Cloudflare Zero Trust > Networks > Tunnels. Leave empty when using docker-compose.lan.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Hex only: it is embedded in the API's DATABASE_URL.
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Required by config validation; /auth/dev-token is never registered when APP_ENV=production.
DEV_AUTH_SECRET=

GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
# Web-application client secret. Server-only: never commit it.
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info

# docker-compose.lan.yml only: host ports for the api and web app (defaults 3100 and 8080).
# API_PORT=3100
# WEB_PORT=8080
