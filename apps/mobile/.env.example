# Copy to .env. EXPO_PUBLIC_* values are inlined into the bundle: never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3100
# Public origin of the web app. It is the Google redirect URI on web, so it must be an authorized
# redirect URI of the Google web client and be listed in the backend GOOGLE_REDIRECT_ALLOWLIST.
EXPO_PUBLIC_WEB_URL=http://localhost:8083
EXPO_PUBLIC_GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
# Non-production builds only: gates the dev sign-in control. Set it to DEV_AUTH_SECRET from the
# repo-root .env. EXPO_PUBLIC_ENV=production hides the control and disables /auth/dev-token calls.
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_DEV_AUTH=
